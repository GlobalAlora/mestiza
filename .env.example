# =============================================================================
# Soy Mestiza — Variables de entorno
# Copiá este archivo a .env.local y completá los valores
# NUNCA commitees .env.local ni ningún archivo con valores reales
# =============================================================================

# ─── Sitio ───────────────────────────────────────────────────────────────────
# URL base del sitio (sin trailing slash). En dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Obtenelos en: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# SERVICE ROLE: SOLO EN SERVIDOR. Jamás en NEXT_PUBLIC_*.
# Para desarrollo local usás la key del proyecto de staging.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtenelos en: developers.mercadopago.com → Credenciales
# Usar credenciales de TEST para desarrollo
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxx
# Secret para validar la firma del webhook (configurado en el panel de MP)
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Resend ──────────────────────────────────────────────────────────────────
# Obtenelo en: resend.com → API Keys
RESEND_API_KEY=re_xxxx
# Email verificado en Resend (ej: hola@soymestiza.com)
RESEND_FROM_EMAIL=hola@soymestiza.com

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Obtenelos en: console.upstash.com → Crea una database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─── Cron ────────────────────────────────────────────────────────────────────
# String aleatorio ≥16 chars. Generalo con: openssl rand -base64 32
CRON_SECRET=

# ─── Analytics (opcionales) ──────────────────────────────────────────────────
# GA4 Measurement ID (ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager ID (ej: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
